{
  "expo": {
    "name": "SapiAR",
    "slug": "SapiAR",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simdevelop.SapiAR",
      "infoPlist": {
        "NSCameraUsageDescription": "SapiAR records the front and back cameras simultaneously during data collection sessions.",
        "NSLocationWhenInUseUsageDescription": "SapiAR logs GPS position during data collection sessions to synchronize location with the recorded video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.simdevelop.SapiAR"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
